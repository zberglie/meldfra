# Kopier til .env (som ALDRI committes). Alle variabler er valgfrie bortsett fra der det står.

MELDFRA_PRODUCT_NAME=Medlemsportalen
MELDFRA_PRODUCT_DESCRIPTION=medlemsportal for Dataforeningen: profil, kontingent, arrangementer, faggrupper
MELDFRA_AREAS=profil,kontingent,arrangement,faggruppe,innlogging,annet

# SQLite holder for test; bruk Postgres i drift (pip install "meldfra[postgres]").
MELDFRA_DATABASE_URL=postgresql+psycopg://meldfra:hemmelig@db:5432/portal
MELDFRA_ATTACHMENT_TTL_DAYS=30

# GitHub: et PRIVAT repo + fine-grained PAT med «Issues: Read and write» på kun det repoet.
MELDFRA_TRACKER=github
MELDFRA_GITHUB_REPO=dataforeningen/medlemsportal
MELDFRA_GITHUB_TOKEN=github_pat_...

# …eller GitLab (sakene blir confidential):
# MELDFRA_TRACKER=gitlab
# MELDFRA_GITLAB_API_URL=https://gitlab.example.no/api/v4
# MELDFRA_GITLAB_TOKEN=glpat-...
# MELDFRA_GITLAB_PROJECT_ID=42

# KI (intervju + triage). Uten nøkkel: brukerens egne ord sendes uten renskriving/triage.
ANTHROPIC_API_KEY=sk-ant-...
MELDFRA_LLM_MODEL=claude-opus-5-5
MELDFRA_LLM_EFFORT=low

# Duplikatdeteksjon (valgfri): OpenAI-kompatibelt embeddings-endepunkt, helst i egen infra.
# MELDFRA_EMBEDDINGS_URL=http://ollama:11434/v1/embeddings
# MELDFRA_EMBEDDINGS_MODEL=bge-m3

# Lenke til admin-visningen av skjermbilder i saksteksten.
MELDFRA_ADMIN_BASE_URL=https://portal.dataforeningen.no/meldfra
# Versjonen som vises i rapportene (settes gjerne av CI).
GIT_SHA=
